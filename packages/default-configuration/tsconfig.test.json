{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "incremental": false,
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/types/*.d.ts",
    "src/streams/lib/session/styles.d.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
