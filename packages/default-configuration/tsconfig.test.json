{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "incremental": false,
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx"
  },
  "include": ["test/**/*.ts", "test/**/*.tsx", "src/types/*.d.ts", "src/streams/lib/session/styles.d.ts"],
  "exclude": ["node_modules", "dist"]
}
