{
  "name": "@cards.management/sessions",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/card-repo.ts",
  "types": "./src/card-repo.ts",
  "exports": {
    "./card-repo": "./src/card-repo.ts",
    "./internal": "./src/internal.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "yarn run -T turbo run test:uncached --filter=@cards.management/sessions --cwd \"$PROJECT_CWD\" --",
    "test:uncached": "vitest run",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src && jsdoczoom -l"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cards.management/test-utils": "workspace:*",
    "@goodfoot/vitest-cache": "^1.0.5",
    "@types/node": "24.x",
    "@typescript/native-preview": "^7.0.0-dev",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
