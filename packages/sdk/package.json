{
  "name": "@cards.management/sdk",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./client": "./src/client/index.ts",
    "./client/runtime": "./src/client/runtime/index.ts",
    "./client/runtime/outbox": "./src/client/runtime/outbox/index.ts",
    "./client/runtime/durable-results": "./src/client/runtime/durable-results/index.ts",
    "./client/discovery": "./src/client/api-discovery.ts",
    "./config": "./src/config/index.ts",
    "./config/factories": "./src/config/factories/index.ts",
    "./config/factories/*": "./src/config/factories/*.ts",
    "./config/cli": "./src/config/cli/index.ts",
    "./config/runtime": "./src/config/runtime.ts",
    "./config/socket-client": "./src/config/socket-client.ts",
    "./config/logger": "./src/config/logger.ts",
    "./config/schema": "./src/config/schema.ts",
    "./config/env": "./src/config/env.ts",
    "./marketplace": "./src/marketplace.ts",
    "./stream-store": "./src/stream-store/index.ts",
    "./worktree": "./src/worktree.ts",
    "./worktree-for-card": "./src/worktreeForCard.ts",
    "./worktree-include": "./src/worktreeInclude.ts",
    "./worktree-path-policy": "./src/worktreePathPolicy.ts",
    "./client/cardRepoFilters": "./src/client/cardRepoFilters.ts",
    "./card-repo": "./src/cardRepo.ts",
    "./card-repo-layout": "./src/cardRepoLayout.ts",
    "./card-summary": "./src/cardSummary.ts",
    "./theme": "./src/theme/cssValue.ts",
    "./search-utils": "./src/searchUtils.ts",
    "./symlink-capability": "./src/symlink-capability.ts",
    "./timer": "./src/timer.ts",
    "./bin/spawn-stream-sync-watcher": "./src/bin/spawn-stream-sync-watcher.ts",
    "./bin/spawn-adhoc-cleanup": "./src/bin/spawn-adhoc-cleanup.ts",
    "./bin/spawn-adhoc-attribution": "./src/bin/spawnAdhocAttribution.ts",
    "./bin/process-utils": "./src/bin/process-utils.ts",
    "./bin/child-process": "./src/bin/childProcess.ts",
    "./bin/adhoc-refs": "./src/bin/adhoc-refs.ts",
    "./process-tree": "./src/process-tree.ts",
    "./session-resolver": "./src/session-resolver.ts",
    "./cards-parent-branch": "./src/cardsParentBranch.ts",
    "./unbound-worktree-candidates": "./src/unboundWorktreeCandidates.ts",
    "./adhoc-attribution": "./src/adhocAttribution.ts",
    "./context": "./src/context.ts",
    "./git-hooks": "./src/git-hooks.ts",
    "./transcript-sync": "./src/transcript-sync/index.ts",
    "./transcript-sync/adapters": "./src/transcript-sync/adapters/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "cards-sdk": "./dist/cli.js"
  },
  "scripts": {
    "build": "build-unchanged --input src --input scripts --input package.json --input ../claude-code-sessions/src --output dist --output ../../claude/cards/scaffold --manifest dist/.build-unchanged.json -- node scripts/build.mjs",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l ./src ./test",
    "test": "vitest-unchanged"
  },
  "dependencies": {
    "@cards.management/sessions": "workspace:*",
    "@typescript/native-preview": "^7.0.0-dev",
    "esbuild": "^0.28.0",
    "glob": "^13.0.0",
    "ignore": "^7.0.5",
    "jsonpath-plus": "^10.4.0",
    "mime-types": "^2.1.35",
    "minimatch": "^10.2.5",
    "puppeteer-core": "^24.42.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cards.management/test-utils": "workspace:*",
    "@types/mime-types": "^3.0.1",
    "@types/node": "24.x",
    "@types/ws": "^8.18.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.5",
    "ws": "^8.20.0"
  }
}
